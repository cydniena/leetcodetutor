# copy to .env
DATABASE_URL=postgres://tutor:tutor@localhost:5433/leetcodetutor
SESSION_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Number of proxies in front of the app, if any. Leave unset unless it is
# deployed behind one: when this is wrong, req.ip becomes whatever the client
# claims in X-Forwarded-For and the per-IP rate limit stops meaning anything.
# TRUST_PROXY=1

# Rate limits on /auth/login and /auth/register. The defaults in
# server/src/middleware/rate-limit.js are the intended policy; these are here
# for tuning against real traffic, and for tests that need a tighter policy.
# RATE_LIMIT_BURST_MAX=10             # requests per IP per burst window
# RATE_LIMIT_BURST_WINDOW_MS=10000    # in-process, protects the pg pool
# RATE_LIMIT_IP_MAX=30                # credential requests per IP per window
# RATE_LIMIT_IP_WINDOW_MS=900000      # 15 minutes
# RATE_LIMIT_EMAIL_FAILURES=5         # failed logins before backoff starts
# RATE_LIMIT_EMAIL_BASE_MS=60000      # first wait, doubling per further failure
# RATE_LIMIT_EMAIL_CAP_MS=900000      # longest wait
# RATE_LIMIT_EMAIL_WINDOW_MS=3600000  # failure streak forgotten after this
