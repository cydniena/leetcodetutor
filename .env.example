# production without it, and generates a throwaway one in development.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
